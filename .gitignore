# raw and cleaned GPX carry timestamps: where you were, when. Never commit them.
*.gpx
raw/*
!raw/README.md

# build output: ./build_plugin.sh assembles plugins/<slug>/ from src/, vacations/ and data/,
# and zips it into dist/. Both are regenerated, never committed. The deploy tool of the
# music_blog repo also drops remote backups into plugins/.remote-backup/.
plugins/
dist/
.remote-backup/

.DS_Store
__pycache__/
